+                                    file
+                                end
                                 toplevel_file =
-                                    if toplevel_files.include?(file) then file
+                                    if toplevel_files.include?(resolved_file)
+                                        resolved_file
                                     else
                                         current_file.last[0]
                                     end
@@ -1515,14 +1555,7 @@ def resolve_toplevel_include_mapping(toplevel_files, **options)
                                 # into the preprocessed output (read here), so we
