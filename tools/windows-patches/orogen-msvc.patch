                             type.metadata.delete("source_file_line")
@@ -1503,8 +1537,14 @@ def resolve_toplevel_include_mapping(toplevel_files, **options)
                             mode = ::Regexp.last_match(3)
 
                             if mode == "1"
+                                resolved_file = begin
+                                    File.realpath(file)
